# ============================================================
# STREAKPAY ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit real secrets to version control.
# ============================================================

# Database
DATABASE_URL=

# Authentication
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# AI Provider
AI_PROVIDER=
AI_API_KEY=

# Payment Provider
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_ACCOUNT_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_BANK_NAME=

# Storage
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=

# Email (for verification, password reset)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Application
APP_URL=http://localhost:3000
DEMO_MODE=true

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Trading Engine
SPK_BASE_PRICE=1.00
SPK_VOLATILITY_FACTOR=0.02
SPK_ACTIVITY_SENTIMENT=0.001
